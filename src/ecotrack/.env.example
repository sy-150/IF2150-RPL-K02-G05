# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK di-commit.

# true = pakai emulator di laptop (cara menjalankan untuk asisten)
# false = pakai Firebase cloud (dipakai tim saat develop dan untuk APK)
EXPO_PUBLIC_USE_EMULATOR=

# Wajib kalau USE_EMULATOR=true: IP laptop yang menjalankan emulator (cek dengan ipconfig), misalnya 192.168.1.5
EXPO_PUBLIC_EMULATOR_HOST=

# Wajib kalau USE_EMULATOR=false: config web app dari Firebase Console → Project settings → Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# URL Cloudflare Worker pemindai (bukan rahasia)
EXPO_PUBLIC_PEMINDAI_URL=
