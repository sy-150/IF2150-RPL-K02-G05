{
  "name": "ecotrack-firebase",
  "private": true,
  "description": "Konfigurasi Firebase EcoTrack: emulator lokal, security rules, dan skrip seed data uji",
  "scripts": {
    "emulator": "firebase emulators:start --project demo-ecotrack",
    "seed": "node seed.js",
    "seed:cloud": "node seed.js --cloud",
    "deploy:rules": "firebase deploy --only firestore",
    "pull:cloud": "node pull.js"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "firebase-tools": "^14.0.0"
  }
}